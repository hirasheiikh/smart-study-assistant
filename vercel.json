{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0" }
      ]
    }
  ],
  "functions": {
    "api/assistant.js": {
      "maxDuration": 30
    },
    "api/telegram.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron?mode=morning",
      "schedule": "5 6 * * *"
    },
    {
      "path": "/api/cron?mode=evening",
      "schedule": "30 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/calendar.ics",
      "destination": "/api/calendar"
    }
  ]
}
